.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# Video and derived media stay on the PC, never in git.
data/
*.mp4
*.mov
*.MOV
*.mkv
# Weights and large run outputs.
models/*
!models/.gitkeep
runs/*
!runs/.gitkeep
.uv-cache/
.ultralytics/
# Local configs are copied from the *.example.yaml files and tuned per site.
configs/detection.yaml
configs/tracker.yaml
configs/lines.yaml
configs/pipeline.yaml
calibration/ground.yaml
Ultralytics/
outputs/viewer_check/
configs/study_settings.yaml
configs/sumo_network.yaml
configs/alternatives.yaml
# Label images show people and plates (privacy, O16); runs of SUMO are outputs.
labels/**/images/
sumo/*/
